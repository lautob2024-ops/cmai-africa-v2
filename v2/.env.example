# ── Base ─────────────────────────────────────────────
NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://www.cmaiplusafrica.com
# Chaîne aléatoire d'au moins 32 caractères (openssl rand -hex 32). OBLIGATOIRE en production.
JWT_SECRET=
# mysql://utilisateur:motdepasse@hote:3306/base
DATABASE_URL=
# E-mails (séparés par des virgules) qui deviennent administrateurs à la connexion
ADMIN_EMAILS=cmai.africa2026@gmail.com

# ── Stockage des fichiers (disque local) ─────────────
# Sur un hébergeur, montez un disque persistant et pointez UPLOAD_DIR dessus.
UPLOAD_DIR=./storage

# ── E-mails (Gmail : mot de passe d'application) ─────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=cmai.africa2026@gmail.com
SMTP_PASS=
SMTP_FROM=cmai.africa2026@gmail.com

# ── Paiement Mobile Money (FedaPay) ──────────────────
PAYMENT_PROVIDER=fedapay
FEDAPAY_SECRET_KEY=
FEDAPAY_ENV=sandbox            # passer à "live" en production
# Taux de conversion utilisé pour les cours affichés en dollars (le Mobile Money encaisse en XOF)
USD_TO_XOF=600

# ── SMS (facultatif) ─────────────────────────────────
SMS_API_URL=
SMS_API_KEY=
